# Production environment. Copy to .env.prod on the server and fill in.
# .env.prod is git-ignored and must never be committed.

# --- managed Postgres -------------------------------------------------------
# Paste the connection string your provider gives you, but change the scheme
# from postgresql:// to postgresql+asyncpg://. Leave ?sslmode=require on the
# end -- the engine translates it, because asyncpg does not accept libpq's
# spelling and every hosted provider hands out a libpq URL.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/DBNAME?sslmode=require

# --- the site ---------------------------------------------------------------
# The domain, with scheme. Caddy reads this to know what certificate to get,
# so it must match the DNS record actually pointing here.
SITE_ADDRESS=https://youredge.example.com

# One login in front of everything, API included. Generate the hash with:
#   docker run --rm caddy caddy hash-password --plaintext 'your password'
#
# ESCAPE EVERY $ AS $$. A bcrypt hash is full of them, and Compose reads a lone
# $name as a variable to interpolate -- so $2a$14$qICw... arrives at Caddy with
# the middle eaten and every login fails against a hash that is not the one you
# generated. Compose warns about it in its own logs and nowhere you will look.
BASIC_AUTH_USER=trey
BASIC_AUTH_HASH=$$2a$$14$$REPLACE_WITH_THE_HASH_NOT_THE_PASSWORD

# --- data providers ---------------------------------------------------------
# The Odds API budget is monthly and shared across every machine using the key.
# Only one deployment should run the poller.
ODDS_API_KEY=
CFBD_API_KEY=
