# Secrets
secrets.env
.env
.env.local
.env.*.local

# Data dumps (regenerable via ingest --dump)
data/
apps/backend/user_data/*

# Environment-specific configuration
conf/local.toml

# Node.js
node_modules/
npm-debug.log
yarn-error.log
apps/web/dist/

# Python build artifacts. These are anchored with a leading slash on purpose:
# a bare `lib/` matches at *any* depth and silently swallowed apps/web/src/sgp/lib/,
# which is how the web app ended up committed without the modules it imports.
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
/build/
/develop-eggs/
/dist/
/downloads/
/eggs/
/.eggs/
/lib/
/lib64/
/parts/
/sdist/
/var/
/wheels/
*.egg-info/
.installed.cfg
*.egg
pip-log.txt
pip-delete-this-directory.txt

# Virtual environments
venv/
ENV/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Temporary files
*.tmp
*.temp
.cache/

# Cache directories
cache/
.pytest_cache/
