# Secrets
secrets.env
.env
.env.local
.env.*.local

# Data dumps (regenerable via ingest --dump)
data/
apps/backend/user_data/*

# Environment-specific configuration
conf/local.toml

# Node.js
node_modules/
npm-debug.log
yarn-error.log
apps/web/dist/

# Python build artifacts. These are anchored with a leading slash on purpose:
# a bare `lib/` matches at *any* depth and silently swallowed apps/web/src/sgp/lib/,
# which is how the web app ended up committed without the modules it imports.
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
/build/
/develop-eggs/
/dist/
/downloads/
/eggs/
/.eggs/
/lib/
/lib64/
/parts/
/sdist/
/var/
/wheels/
*.egg-info/
.installed.cfg
*.egg
pip-log.txt
pip-delete-this-directory.txt

# Virtual environments
venv/
ENV/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Temporary files
*.tmp
*.temp
.cache/

# Cache directories
cache/
.pytest_cache/

# Database dumps and hand-collected quote sheets. Small enough to be tempting
# and large enough to ruin a clone; keep them somewhere that is not git.
backups/

# Production secrets. Same rule as .env: never committed.
#
# Globbed, not literal. The exact-match version covered `.env.prod` and nothing
# else, so `.env.prod.bak` -- a hand-made copy holding the same Neon password and
# the same two API keys -- sat untracked and unignored for four days, one `git
# add -A` from being published. A backup of a secret is a secret, and the naming
# is whatever the hand that made it chose, so match the family rather than the
# one spelling anyone thought of.
.env.prod*
# ...except the template, which is the one file in the family that must be committed.
# It is tracked today, so the glob above cannot hide it -- .gitignore does not apply
# to tracked files -- but that protection lasts exactly until someone untracks and
# re-adds it, and losing the template is a silent way to make a deploy undocumented.
!.env.prod.example
.neon
