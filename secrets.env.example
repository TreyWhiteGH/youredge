# YoureEdge Backend Secrets Template
# Copy this file to secrets.env and fill in your actual values
# NEVER commit secrets.env to version control!

# Google Cloud Platform Configuration
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# GCP Credentials: Set the path to your local credentials JSON file
# Alternative: If using gcp.credentials_path in config, set path there instead
# The standard Google Cloud SDK path is ~/.config/gcloud/application_default_credentials.json
GOOGLE_APPLICATION_CREDENTIALS=/path/to/gcp-credentials.json

# The Odds API Configuration
THE_ODDS_API_KEY=your-odds-api-key

# Optional: Override config values using environment variables
# Legacy format examples:
# LOG_LEVEL=DEBUG
# PORT=8080
# MODELS_DIR=/path/to/models

# New format examples (YOUREDGE_{SECTION}_{KEY}):
# YOUREDGE_APP_LOG_LEVEL=DEBUG
# YOUREDGE_APP_PORT=8080
# YOUREDGE_CACHE_SCORE_TTL=1800
